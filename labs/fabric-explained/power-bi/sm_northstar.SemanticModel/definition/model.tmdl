/// NorthStar hotel analytics model for analyzing customers served,
/// location growth, product performance, and reservation cancellations.
/// The model combines booking, stay, guest, property, experience,
/// channel, inventory, satisfaction, and budget data.
/// Use this model to answer four core questions:
/// How many customers did we serve?
/// Which locations are growing?
/// Which products perform the best?
/// Why are cancellations increasing?
model Model
	culture: en-US
	collation: Latin1_General_100_BIN2_UTF8
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["WebModelingEdit","TMDLView_Desktop","RemoteModeling","CopilotTooling","DaxQueryView_Desktop","MCP-PBIModeling","DirectLakeOnOneLakeInWeb"]

annotation PBI_QueryOrder = ["DatabaseQuery"]

annotation __PBI_ServiceStoredInTmdl = reserved

ref table DimProperty
ref table DimGuest
ref table DimChannel
ref table DimExperience
ref table DimDate
ref table FactBooking
ref table FactStayNight
ref table FactPropertyInventory
ref table FactGuestSatisfaction
ref table FactPropertyBudget
ref table FactPropertyEvent

ref cultureInfo en-US

