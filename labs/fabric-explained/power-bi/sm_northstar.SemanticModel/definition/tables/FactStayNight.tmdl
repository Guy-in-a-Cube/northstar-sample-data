/// Realized stay activity, with one row per stay-night. Use this table to analyze customers actually served, rooms occupied, realized revenue, and stay trends.
table FactStayNight
	lineageTag: ac1e624a-69d7-465b-ba48-6877acae0ef9
	sourceLineageTag: [dw].[FactStayNight]

	/// Total number of occupied rooms from realized stay activity in the current filter context.
	measure 'Rooms Occupied' = ```
			
			    SUM ( 'FactStayNight'[RoomsOccupied] )
			```
		formatString: #,##0
		displayFolder: Capacity & Occupancy
		lineageTag: de613735-3d33-4b5e-8e3d-e4583dbb9a7c

		changedProperty = FormatString

		changedProperty = Description

	/// Total realized revenue from occupied rooms in the current filter context.
	measure 'Room Revenue' = ```
			
			    SUM ( 'FactStayNight'[RoomRevenue] )
			```
		formatString: $#,##0.00
		displayFolder: Revenue
		lineageTag: 90a3d43d-9b78-46e0-b6ce-2fed04dd59c2

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Total realized revenue from products and experiences purchased as part of a stay in the current filter context.
	measure 'Experience Revenue' = ```
			
			    SUM ( 'FactStayNight'[ExperienceRevenue] )
			```
		formatString: $#,##0.00
		displayFolder: Revenue
		lineageTag: 93db3423-e135-4c5a-a3a5-20d8128dbc79

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Total realized revenue from sources other than rooms and experiences in the current filter context.
	measure 'Other Revenue' = ```
			
			    SUM ( 'FactStayNight'[OtherRevenue] )
			```
		formatString: $#,##0.00
		displayFolder: Revenue
		lineageTag: 914fbfbc-3ae4-42bc-9574-23145682c80e

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Total discount amount applied to realized stay activity in the current filter context.
	measure 'Discount Amount' = ```
			
			    SUM ( 'FactStayNight'[DiscountAmount] )
			```
		formatString: $#,##0.00
		displayFolder: Revenue
		lineageTag: 75ede0cf-1231-40e6-a4ac-6b299ee57039

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Total realized revenue before discounts in the current filter context, including room revenue, experience revenue, and other revenue.
	measure 'Gross Revenue' = ```
			
			      [Room Revenue]
			    + [Experience Revenue]
			    + [Other Revenue]
			```
		formatString: $#,##0.00
		displayFolder: Revenue
		lineageTag: dffc6104-dc8e-487b-a986-a9803f2da974

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Total realized revenue after discounts in the current filter context. Includes room revenue, experience revenue, and other revenue, less discounts.
	measure 'Total Revenue' = ```
			
			      [Gross Revenue]
			    - [Discount Amount]
			```
		formatString: $#,##0.00
		displayFolder: Revenue
		lineageTag: 8d0ea75d-8621-49c5-863e-6bfa2f6a22ff

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Average Daily Rate for realized stays in the current filter context. Calculated as room revenue divided by rooms occupied.
	measure ADR = ```
			
			    DIVIDE (
			        [Room Revenue],
			        [Rooms Occupied]
			    )
			```
		formatString: $#,##0.00
		displayFolder: Revenue
		lineageTag: ce86e09e-694d-45d1-81f8-6f00f840d6d1

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Distinct number of customers who actually stayed at a NorthStar property in the current filter context. Customers with reservations but no realized stay are not included.
	measure 'Customers Served' =
			
			DISTINCTCOUNT ( 'FactStayNight'[GuestKey] )
		formatString: #,##0
		displayFolder: Customers
		lineageTag: 312ab346-9440-41a2-af2e-dc74b9c0e27c

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

	/// Total realized revenue after discounts for the equivalent date period one year earlier, using the active stay-date relationship.
	measure 'Total Revenue PY' =
			CALCULATE (
			    [Total Revenue],
			    REMOVEFILTERS ( 'DimDate' ),
			    DATEADD ( 'DimDate'[FullDate], -1, YEAR )
			)
		formatString: $#,##0.00
		displayFolder: Time Comparison
		lineageTag: a16c1eee-252a-4152-8cf4-e5044bf0a872

	/// Year-over-year percentage change in total realized revenue. Positive values indicate growth versus the equivalent prior-year period.
	measure 'Total Revenue YoY %' =
			DIVIDE (
			    [Total Revenue] - [Total Revenue PY],
			    [Total Revenue PY]
			)
		formatString: 0.0%
		displayFolder: Time Comparison
		lineageTag: 9bc04a8d-d267-4758-87cd-125fb66cc40d

	/// Distinct customers who stayed during the equivalent date period one year earlier, using the active stay-date relationship.
	measure 'Customers Served PY' =
			CALCULATE (
			    [Customers Served],
			    REMOVEFILTERS ( 'DimDate' ),
			    DATEADD ( 'DimDate'[FullDate], -1, YEAR )
			)
		formatString: #,##0
		displayFolder: Time Comparison
		lineageTag: 257d0027-fd66-4fb1-b7bd-1bdb2b7aad55

	/// Year-over-year percentage change in distinct customers served. Positive values indicate growth versus the equivalent prior-year period.
	measure 'Customers Served YoY %' =
			DIVIDE (
			    [Customers Served] - [Customers Served PY],
			    [Customers Served PY]
			)
		formatString: 0.0%
		displayFolder: Time Comparison
		lineageTag: c4a917d7-86e7-47cb-b95a-9e35a5dac724

	/// Realized experience revenue for the equivalent date period one year earlier, using the active stay-date relationship.
	measure 'Experience Revenue PY' =
			CALCULATE (
			    [Experience Revenue],
			    REMOVEFILTERS ( 'DimDate' ),
			    DATEADD ( 'DimDate'[FullDate], -1, YEAR )
			)
		formatString: $#,##0.00
		displayFolder: Time Comparison
		lineageTag: 8582106d-4136-4957-a724-986a875d72e9

	/// Year-over-year percentage change in realized experience revenue. Positive values indicate growth versus the equivalent prior-year period.
	measure 'Experience Revenue YoY %' =
			DIVIDE (
			    [Experience Revenue] - [Experience Revenue PY],
			    [Experience Revenue PY]
			)
		formatString: 0.0%
		displayFolder: Time Comparison
		lineageTag: 23c01750-15c2-4f8a-9308-7383b9368387

