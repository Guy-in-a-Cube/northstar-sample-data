		isHidden
		sourceProviderType: decimal(18, 2)
		lineageTag: cb721bda-5a5c-44b5-b748-ca256cc4c561
		sourceLineageTag: BudgetRevenue
		summarizeBy: sum
		sourceColumn: BudgetRevenue

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column BudgetOccupancyPct
		dataType: decimal
		isHidden
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		sourceProviderType: decimal(9, 4)
		lineageTag: db79ec40-99e6-484e-bf3b-6c22ba3b7d0d
		sourceLineageTag: BudgetOccupancyPct
		summarizeBy: sum
		sourceColumn: BudgetOccupancyPct

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column SourceUpdatedAt
		dataType: dateTime
		isHidden
		formatString: General Date
		sourceProviderType: datetime2
		lineageTag: 384d535c-28a2-4eff-86ff-494766d85234
		sourceLineageTag: SourceUpdatedAt
		summarizeBy: none
		sourceColumn: SourceUpdatedAt

		changedProperty = IsHidden

