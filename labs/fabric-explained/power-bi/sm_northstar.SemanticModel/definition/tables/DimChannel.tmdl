/// Channels through which customers make reservations. Use this table to analyze booking and cancellation behavior by reservation channel.
table DimChannel
	lineageTag: ba0f2bfc-a0f7-4bd3-b923-1cb0d66affc8
	sourceLineageTag: [dw].[DimChannel]

	column ChannelKey
		dataType: int64
		isHidden
		formatString: 0
		sourceProviderType: bigint
		lineageTag: 069bf03d-b185-44d0-b1b6-b6299eaa957a
		sourceLineageTag: ChannelKey
		summarizeBy: none
		sourceColumn: ChannelKey

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Business identifier assigned to a reservation channel. Use ChannelName for display and grouping; do not aggregate this code.
	column ChannelCode
		dataType: int64
		formatString: 0
		sourceProviderType: int
		lineageTag: 9b73756b-a5ee-40f1-b9af-eafeeb5c59a8
		sourceLineageTag: ChannelCode
		summarizeBy: none
		sourceColumn: ChannelCode

