/// NorthStar hotel locations. Use this table to analyze performance by property, market, region, property type, and luxury tier.
table DimProperty
	lineageTag: ad75f998-8889-4ddd-a753-4f3def5a37c8
	sourceLineageTag: [dw].[DimProperty]

	measure 'Property Image URL' =
			
			VAR SelectedProperty =
			    SELECTEDVALUE ( 'DimProperty'[PropertyName] )
			VAR ImageFile =
			    SWITCH (
			        SelectedProperty,
			        "Alpine Crest",         "01_Alpine_Crest.png",
			        "Capital Plaza",        "02_Capital_Plaza.png",
			        "Downtown Central",     "03_Downtown_Central.png",
			        "Garden Family Suites", "04_Garden_Family_Suites.png",
			        "Harbor View Hotel",    "05_Harbor_View_Hotel.png",
			        "Lakefront Escape",     "06_Lakefront_Escape.png",
			        "Market Street Stay",   "07_Market_Street_Stay.png",
			        "Metro Business Inn",   "08_Metro_Business_Inn.png",
			        "Palm Bay Suites",      "09_Palm_Bay_Suites.png",
			        "Pine Ridge Lodge",     "10_Pine_Ridge_Lodge.png",
			        "Riverside Retreat",    "11_Riverside_Retreat.png",
			        "Seaside Grand",        "12_Seaside_Grand.png",
			        "Shoreline Lodge",      "13_Shoreline_Lodge.png",
			        "Snowline Retreat",     "14_Snowline_Retreat.png",
			        "Summit Vista",         "15_Summit_Vista.png",
			        "Sunset Park Hotel",    "16_Sunset_Park_Hotel.png"
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( ImageFile ),
			        "__PROPERTY_IMAGE_BASE_URL__"
			            & ImageFile
			    )
		lineageTag: 253a85aa-b8c1-4492-9b32-86e82d096509
		dataCategory: ImageUrl

		changedProperty = Name

		changedProperty = DataCategory

	measure 'Property Information' =
			
			var _selectedProperty = SELECTEDVALUE(DimProperty[PropertyName])
			var _seelctedPropertyType = SELECTEDVALUE(DimProperty[PropertyType])
			var _selectedRoomCount = SELECTEDVALUE(DimProperty[RoomCount])
			var _display =  _selectedProperty &" - "& _seelctedPropertyType & " (" &  _selectedRoomCount & ")"
			RETURN
			IF(ISBLANK(_selectedProperty), "Northstar Properties", _display)
		lineageTag: c50155ba-5875-4745-bd3f-5c874ec31434

		changedProperty = Name

	measure 'Property Image URL NS' =
			
			VAR BaseURL =
			    "__PROPERTY_IMAGE_BASE_URL__"
			VAR PropertyName =
			    SELECTEDVALUE ( 'DimProperty'[PropertyName] )
			VAR PropertyFileName =
			    SUBSTITUTE ( PropertyName, " ", "" )
			VAR ImageFile =
			    IF (
			        ISBLANK ( PropertyName ),
			        "NorthStarCollection.png",
			        PropertyFileName & ".png"
			    )
			RETURN
			    BaseURL & ImageFile
		lineageTag: 79331a07-abaa-4b1f-b551-3d95e85c2cc4

		changedProperty = Name

	measure 'Property Image URL Property' =
			
			VAR BaseURL =
			    "__PROPERTY_IMAGE_BASE_URL__"
			VAR PropertyName =
			    SELECTEDVALUE ( 'DimProperty'[PropertyName] )
			VAR PropertyFileName =
			    SUBSTITUTE ( PropertyName, " ", "" )
			VAR ImageFile =
			    IF (
			        ISBLANK ( PropertyName ),
			        "NorthStarCollection.png",
			        PropertyFileName & ".png"
			    )
			RETURN
			    BaseURL & ImageFile
		lineageTag: 34cee37e-c333-412a-887f-2cfe857be398

		changedProperty = Name

	column PropertyKey
		dataType: int64
		isHidden
		formatString: 0
		sourceProviderType: bigint
		lineageTag: ef4af5c1-7e81-44f5-aa6d-6eb198f5c065
		sourceLineageTag: PropertyKey
		summarizeBy: none
		sourceColumn: PropertyKey

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Business identifier assigned to a NorthStar property. Use PropertyName for display and grouping; do not aggregate this code.
	column PropertyCode
		dataType: int64
		formatString: 0
		sourceProviderType: int
		lineageTag: 7cbdb2c7-c108-411f-88ef-4f24e8abf0ed
		sourceLineageTag: PropertyCode
		summarizeBy: none
		sourceColumn: PropertyCode

		annotation SummarizationSetBy = Automatic

	/// Business-facing name of a NorthStar hotel or property. Use when users ask about a hotel, property, location, or site.
	column PropertyName
		dataType: string
		sourceProviderType: varchar(100)
		lineageTag: c2b176cc-ea1c-4fe6-a8b2-d9847184a8dd
		sourceLineageTag: PropertyName
		isDefaultLabel
		summarizeBy: none
		sourceColumn: PropertyName

		annotation SummarizationSetBy = Automatic

	/// Broad NorthStar operating region used to group properties, such as Urban, Coastal, Leisure, or Mountain.
	column Region
		dataType: string
		sourceProviderType: varchar(50)
		lineageTag: c913dcec-4b49-4cff-bc4f-749f36c47825
		sourceLineageTag: Region
		summarizeBy: none
		sourceColumn: Region

		annotation SummarizationSetBy = Automatic

	/// City or destination market where the NorthStar property operates, such as New York, Miami, or Las Vegas.
	column Market
		dataType: string
		sourceProviderType: varchar(100)
		lineageTag: 7c4c5d2a-1a9c-4635-a14c-47e5fc2f1953
		sourceLineageTag: Market
		summarizeBy: none
		sourceColumn: Market

		annotation SummarizationSetBy = Automatic

	/// Operating format of the property, such as Hotel, Resort, Lodge, or Boutique.
	column PropertyType
		dataType: string
		sourceProviderType: varchar(50)
		lineageTag: 6e752b6a-cb34-4810-bcae-e7b96e8d384f
		sourceLineageTag: PropertyType
		summarizeBy: none
		sourceColumn: PropertyType

		annotation SummarizationSetBy = Automatic

	/// NorthStar service tier assigned to the property: Standard, Premium, or Luxury.
	column LuxuryTier
		dataType: string
		sourceProviderType: varchar(50)
		lineageTag: 7fd3ceee-7095-44cc-8157-c3a5722ca635
		sourceLineageTag: LuxuryTier
		summarizeBy: none
		sourceColumn: LuxuryTier

		annotation SummarizationSetBy = Automatic

	/// Number of physical guest rooms at the property. Use inventory measures for date-specific sellable capacity.
	column RoomCount
		dataType: int64
		formatString: 0
		sourceProviderType: int
		lineageTag: 10dc6c0a-6841-42ac-9cc5-ca41aba9d1d9
		sourceLineageTag: RoomCount
		summarizeBy: sum
		sourceColumn: RoomCount

		annotation SummarizationSetBy = Automatic

	/// Date the NorthStar property opened for guest operations.
	column OpenDate
		dataType: dateTime
		formatString: General Date
		sourceProviderType: date
		lineageTag: 703d73f3-e2d3-4738-b7be-c0fb49195ab0
		sourceLineageTag: OpenDate
		summarizeBy: none
		sourceColumn: OpenDate

		annotation SummarizationSetBy = Automatic

	column SourceUpdatedAt
		dataType: dateTime
		isHidden
		formatString: General Date
		sourceProviderType: datetime2
		lineageTag: 6ef4614d-9e24-4006-8121-356a9b89e851
		sourceLineageTag: SourceUpdatedAt
		summarizeBy: none
		sourceColumn: SourceUpdatedAt

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Property drill path from operating region through market to individual property.
	hierarchy Property
		lineageTag: 8d53f8bc-d440-4d32-a3e3-0e7c5fa7d88e

		level Region
			lineageTag: 23b5aa9c-562a-47b9-b660-d88e0ce6e572
			column: Region

		level Market
			lineageTag: b71ce3c5-7b6a-4771-9f1a-daa66fa5304d
			column: Market

		level Property
			lineageTag: cbac2254-4f7e-4c57-82ee-6f21f74d367a
			column: PropertyName

	partition DimProperty = entity
		mode: directLake
		source
			entityName: DimProperty
			schemaName: dw
			expressionSource: DatabaseQuery

	changedProperty = Description

