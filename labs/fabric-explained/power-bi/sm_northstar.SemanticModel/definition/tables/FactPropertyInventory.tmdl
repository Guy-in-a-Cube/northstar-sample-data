/// Daily room inventory by NorthStar property. Use this table to analyze room capacity, sellable rooms, rooms out of service, and occupancy.
table FactPropertyInventory
	lineageTag: a2be79f3-2e3a-403b-afb6-ddea6ae11710
	sourceLineageTag: [dw].[FactPropertyInventory]

	/// Total room capacity across NorthStar properties in the current filter context.
	measure 'Room Capacity' = ```
			
			    SUM ( 'FactPropertyInventory'[RoomCapacity] )
			```
		formatString: #,##0
		displayFolder: Capacity & Occupancy
		lineageTag: 5682936c-7e06-4fa4-9032-a8628048c199

		changedProperty = FormatString

		changedProperty = Description

	/// Total number of rooms unavailable for sale because they were out of service in the current filter context.
	measure 'Rooms Out of Service' = ```
			
			    SUM ( 'FactPropertyInventory'[RoomsOutOfService] )
			```
		formatString: #,##0
		displayFolder: Capacity & Occupancy
		lineageTag: 89ef12c2-c7a9-4c87-9d40-a81a3b68bb1a

		changedProperty = FormatString

		changedProperty = Description

	/// Total number of rooms available for sale at NorthStar properties in the current filter context.
	measure 'Rooms Sellable' = ```
			
			    SUM ( 'FactPropertyInventory'[RoomsSellable] )
			```
		formatString: #,##0
		displayFolder: Capacity & Occupancy
		lineageTag: 3c74f6b5-7a18-4e5c-9dc2-ecf17147dfdf

		changedProperty = FormatString

		changedProperty = Description

	/// Percentage of sellable rooms that were occupied in the current filter context. Calculated as rooms occupied divided by rooms sellable.
	measure 'Occupancy %' = ```
			
			    DIVIDE (
			        [Rooms Occupied],
			        [Rooms Sellable]
			    )
			```
		formatString: 0.0%
		displayFolder: Capacity & Occupancy
		lineageTag: 12927444-76dd-4336-b2a5-c28555570bea

		changedProperty = FormatString

		changedProperty = Description

	/// Revenue per available room in the current filter context. Calculated as room revenue divided by rooms sellable.
	measure RevPAR = ```
			
			    DIVIDE (
			        [Room Revenue],
			        [Rooms Sellable]
			    )
			```
		formatString: $#,##0.00
		displayFolder: Revenue
		lineageTag: 9ce4209e-550e-4a3c-9db0-e687b87564d3

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Occupancy rate for the equivalent inventory-date period one year earlier.
	measure 'Occupancy % PY' =
			CALCULATE (
			    [Occupancy %],
			    REMOVEFILTERS ( 'DimDate' ),
			    DATEADD ( 'DimDate'[FullDate], -1, YEAR )
			)
		formatString: 0.0%
		displayFolder: Time Comparison
		lineageTag: 37a42e7e-8949-4030-9561-317353f031a2

	/// Year-over-year change in occupancy rate, expressed in percentage points. Positive values mean occupancy increased versus prior year.
	measure 'Occupancy YoY Change' =
			IF (
			    NOT ISBLANK ( [Occupancy % PY] ),
			    [Occupancy %] - [Occupancy % PY]
			)
		formatString: 0.0%
		displayFolder: Time Comparison
		lineageTag: 7dd3e51a-8aec-4ae3-8171-ef65037eae78

	column PropertyInventoryID
		dataType: int64
		isHidden
		formatString: 0
		sourceProviderType: bigint
		lineageTag: e77efd4c-8f85-45bb-bd44-41f367268883
		sourceLineageTag: PropertyInventoryID
		summarizeBy: count
		sourceColumn: PropertyInventoryID

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Warehouse date key for the daily property inventory snapshot. Active DimDate role used for capacity and occupancy analysis.
	column DateKey
		dataType: int64
		isHidden
