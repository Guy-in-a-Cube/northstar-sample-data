/// Guest satisfaction survey responses. Use this table to analyze overall satisfaction, service, cleanliness, value, and recommendation behavior.
table FactGuestSatisfaction
	lineageTag: 8e406884-f108-4d0a-9927-cf3724a7761b
	sourceLineageTag: [dw].[FactGuestSatisfaction]

	/// Total number of guest satisfaction survey responses in the current filter context.
	measure 'Survey Responses' = ```
			
			    COUNTROWS ( 'FactGuestSatisfaction' )
			```
		formatString: #,##0
		displayFolder: Satisfaction
		lineageTag: c04b253c-42c2-4b0a-91b6-ad1d3a72fb24

		changedProperty = FormatString

		changedProperty = Description

	/// Average overall satisfaction rating reported by customers who completed a satisfaction survey in the current filter context.
	measure 'Average Satisfaction Score' = ```
			
			    AVERAGE ( 'FactGuestSatisfaction'[SatisfactionScore] )
			```
		formatString: 0.0
		displayFolder: Satisfaction
		lineageTag: 012f2a46-6028-4cd9-a692-ecda85eb8023

		changedProperty = FormatString

		changedProperty = Description

	/// Average service rating reported by customers who completed a satisfaction survey in the current filter context.
	measure 'Average Service Score' = ```
			
			    AVERAGE ( 'FactGuestSatisfaction'[ServiceScore] )
			```
		formatString: 0.0
		displayFolder: Satisfaction
		lineageTag: fe1a14e1-6d30-4719-8010-2f214ced38b5

		changedProperty = FormatString

		changedProperty = Description

	/// Average cleanliness rating reported by customers who completed a satisfaction survey in the current filter context.
	measure 'Average Cleanliness Score' = ```
			
			    AVERAGE ( 'FactGuestSatisfaction'[CleanlinessScore] )
			```
		formatString: 0.0
		displayFolder: Satisfaction
		lineageTag: 4493a7d9-cc22-4abd-8109-b034e7121f04

		changedProperty = FormatString

		changedProperty = Description

	/// Average value rating reported by customers who completed a satisfaction survey in the current filter context.
	measure 'Average Value Score' = ```
			
			    AVERAGE ( 'FactGuestSatisfaction'[ValueScore] )
			```
		formatString: 0.0
		displayFolder: Satisfaction
		lineageTag: c5d213bf-e1b5-4f46-9626-95471d2217ec

		changedProperty = FormatString

		changedProperty = Description

	/// Total number of survey respondents who indicated they would recommend the NorthStar property in the current filter context.
	measure 'Would Recommend' = ```
			
			    CALCULATE (
			        [Survey Responses],
			        'FactGuestSatisfaction'[WouldRecommend] = TRUE ()
			    )
			```
		formatString: #,##0
		displayFolder: Satisfaction
		lineageTag: cab292b8-6891-4a7e-9036-7d69c7ae4d80

		changedProperty = FormatString

		changedProperty = Description

	/// Percentage of survey respondents who indicated they would recommend the NorthStar property in the current filter context.
	measure 'Recommendation Rate' = ```
			
			    DIVIDE (
			        [Would Recommend],
			        [Survey Responses]
			    )
			```
		formatString: 0.0%
		displayFolder: Satisfaction
		lineageTag: fbab8bbc-d0b7-4ac3-948b-1a123a152110

		changedProperty = FormatString

		changedProperty = Description

	/// Total survey responses analyzed by guest stay date instead of survey submission date.
	measure 'Survey Responses by Stay Date' =
			CALCULATE (
			    [Survey Responses],
			    CROSSFILTER ( 'FactGuestSatisfaction'[SurveyDateKey], 'DimDate'[DateKey], NONE ),
			    USERELATIONSHIP ( 'FactGuestSatisfaction'[StayDateKey], 'DimDate'[DateKey] )
			)
		formatString: #,##0
		displayFolder: Satisfaction
		lineageTag: c37832d6-644f-4d4f-891f-6adb0e4aea17

	/// Average 1-5 satisfaction score analyzed by guest stay date instead of survey submission date.
	measure 'Average Satisfaction Score by Stay Date' =
			CALCULATE (
			    [Average Satisfaction Score],
			    CROSSFILTER ( 'FactGuestSatisfaction'[SurveyDateKey], 'DimDate'[DateKey], NONE ),
			    USERELATIONSHIP ( 'FactGuestSatisfaction'[StayDateKey], 'DimDate'[DateKey] )
			)
		formatString: 0.0
		displayFolder: Satisfaction
		lineageTag: e29a8f31-cf2e-4bdd-a4fa-494832b020bb

	/// Difference between the current property satisfaction score and the portfolio average in the current filter context.
	measure 'Satisfaction vs Portfolio' = ```
					VAR CurrentScore =
						[Average Satisfaction Score]
					VAR PortfolioScore =
						CALCULATE (
							[Average Satisfaction Score],
							REMOVEFILTERS ( 'DimProperty' )
						)
					RETURN
						CurrentScore - PortfolioScore
					
			```
		formatString: 0.00
		displayFolder: Satisfaction
		lineageTag: 98b339ae-dfa5-484b-9120-a1ffd9a02882

