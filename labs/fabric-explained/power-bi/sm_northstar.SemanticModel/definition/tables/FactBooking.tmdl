	/// Warehouse date key for scheduled check-out. Inactive DimDate role; use check-out-specific measures instead of filtering this key.
	column CheckOutDateKey
		dataType: int64
		isHidden
		formatString: 0
		sourceProviderType: int
		lineageTag: be3551b7-8954-4037-87b7-d1d1c3ab3814
