/// Reservation activity at NorthStar properties, with one row per reservation. Use this table to analyze bookings, cancellations, booking channels, loyalty behavior, and reservation trends.
table FactBooking
	lineageTag: 168f167f-6f4b-4267-bf36-529572f0a50c
	sourceLineageTag: [dw].[FactBooking]

	/// Total number of reservations made at NorthStar properties in the current filter context. Includes both active and cancelled reservations.
	measure Bookings = ```
			
			    COUNTROWS ( 'FactBooking' )
			```
		formatString: #,##0
		displayFolder: Booking
		lineageTag: 9599519b-9a92-4c5f-bf4b-2cfb8b445ac5

		changedProperty = FormatString

		changedProperty = Description

	/// Total number of nights associated with reservations in the current filter context.
	measure 'Nights Booked' = ```
			
			    SUM ( 'FactBooking'[NightsBooked] )
			```
		formatString: #,##0
		displayFolder: Booking
		lineageTag: fdb6f6a1-e396-4322-8130-b604becd6787

		changedProperty = FormatString

		changedProperty = Description

	/// Total number of rooms associated with reservations in the current filter context.
	measure 'Rooms Booked' = ```
			
			    SUM ( 'FactBooking'[RoomsBooked] )
			```
		formatString: #,##0
		displayFolder: Booking
		lineageTag: e4b4e108-7593-45b9-b9f6-021d1d98d97e

		changedProperty = FormatString

		changedProperty = Description

	/// Total number of reservations that were cancelled in the current filter context.
	measure 'Cancelled Bookings' = ```
			
			    CALCULATE (
			        [Bookings],
			        'FactBooking'[IsCancelled] = TRUE ()
			    )
			```
		formatString: #,##0
		displayFolder: Booking
		lineageTag: 1e41a907-3fe1-459d-bc44-addd845ccb1e

		changedProperty = FormatString

		changedProperty = Description

	/// Percentage of reservations cancelled in the current filter context. Use for cancellation trends by time, property, channel, customer segment, or other business dimensions.
	measure 'Cancellation Rate' = ```
			
			    DIVIDE (
			        [Cancelled Bookings],
			        [Bookings]
			    )
			```
		formatString: 0.0%
		displayFolder: Booking
		lineageTag: 81256932-38f2-4150-a7b7-a1f03ca2f07c

		changedProperty = FormatString

		changedProperty = Description

	/// Total monetary amount associated with cancelled reservations in the current filter context.
	measure 'Cancellation Amount' = ```
			
			    SUM ( 'FactBooking'[CancellationAmount] )
			```
		formatString: $#,##0.00
		displayFolder: Booking
		lineageTag: a9a44abc-a7e9-4c50-a1fc-c9b720ba8ad7

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Total number of reservations identified as loyalty bookings in the current filter context.
	measure 'Loyalty Bookings' = ```
			
			    CALCULATE (
			        [Bookings],
			        'FactBooking'[IsLoyaltyBooking] = TRUE ()
			    )
			```
		formatString: #,##0
		displayFolder: Customers
		lineageTag: ac57609d-8eec-4432-8546-62e8c9c523fa

		changedProperty = FormatString

		changedProperty = Description

	/// Percentage of reservations identified as loyalty bookings in the current filter context.
	measure 'Loyalty Booking %' = ```
			
			    DIVIDE (
			        [Loyalty Bookings],
			        [Bookings]
			    )
			```
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: 4ad7f3e2-5227-4a4f-abd2-f2b15c8475df

		changedProperty = FormatString

		changedProperty = Description

	/// Reservation cancellation rate for the equivalent booking-date period one year earlier.
	measure 'Cancellation Rate PY' =
			CALCULATE (
			    [Cancellation Rate],
			    REMOVEFILTERS ( 'DimDate' ),
			    DATEADD ( 'DimDate'[FullDate], -1, YEAR )
			)
		formatString: 0.0%
		displayFolder: Time Comparison
		lineageTag: 74a11105-9db3-49d0-a96a-737fbd2ac7e9

	/// Year-over-year change in cancellation rate, expressed in percentage points. Positive values mean cancellation rate increased versus prior year.
	measure 'Cancellation Rate YoY Change' =
			IF (
			    NOT ISBLANK ( [Cancellation Rate PY] ),
			    [Cancellation Rate] - [Cancellation Rate PY]
			)
		formatString: 0.0%
		displayFolder: Time Comparison
		lineageTag: fb5d3cb2-7506-4fd1-a6e0-5e59242e8719

	/// Total reservations analyzed by scheduled check-in date instead of booking date. Includes active and cancelled reservations.
	measure 'Bookings by Check-In Date' =
			CALCULATE (
			    [Bookings],
			    CROSSFILTER ( 'FactBooking'[BookingDateKey], 'DimDate'[DateKey], NONE ),
			    USERELATIONSHIP ( 'FactBooking'[CheckInDateKey], 'DimDate'[DateKey] )
			)
		formatString: #,##0
		displayFolder: Booking
		lineageTag: 024cafc8-2bb1-49e7-9d51-1b1efebb2f77

	/// Total reserved rooms analyzed by scheduled check-in date instead of booking date.
	measure 'Rooms Booked by Check-In Date' =
			CALCULATE (
			    [Rooms Booked],
			    CROSSFILTER ( 'FactBooking'[BookingDateKey], 'DimDate'[DateKey], NONE ),
			    USERELATIONSHIP ( 'FactBooking'[CheckInDateKey], 'DimDate'[DateKey] )
			)
		formatString: #,##0
		displayFolder: Booking
		lineageTag: e2ce3cb0-46fe-4bee-8a9f-796ae82dab84

	/// Total reserved nights analyzed by scheduled check-in date instead of booking date.
	measure 'Nights Booked by Check-In Date' =
			CALCULATE (
			    [Nights Booked],
			    CROSSFILTER ( 'FactBooking'[BookingDateKey], 'DimDate'[DateKey], NONE ),
			    USERELATIONSHIP ( 'FactBooking'[CheckInDateKey], 'DimDate'[DateKey] )
			)
		formatString: #,##0
		displayFolder: Booking
		lineageTag: 1a09242b-d7a8-4cb8-972e-d916af3ea7d9

	/// Total reservations analyzed by scheduled check-out date instead of booking date. Includes active and cancelled reservations.
	measure 'Bookings by Check-Out Date' =
			CALCULATE (
			    [Bookings],
			    CROSSFILTER ( 'FactBooking'[BookingDateKey], 'DimDate'[DateKey], NONE ),
			    USERELATIONSHIP ( 'FactBooking'[CheckOutDateKey], 'DimDate'[DateKey] )
			)
		formatString: #,##0
		displayFolder: Booking
		lineageTag: 8c1615e8-6639-46ea-a094-9aac956ff2c9

