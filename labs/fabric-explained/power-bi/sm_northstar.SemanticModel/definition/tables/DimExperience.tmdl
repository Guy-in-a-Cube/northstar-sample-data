/// Products and experiences available to NorthStar customers. Use this table to compare product and experience performance.
table DimExperience
	lineageTag: 3d721cc3-ac81-448b-a70b-dc32c2f7b9c9
	sourceLineageTag: [dw].[DimExperience]

	column ExperienceKey
		dataType: int64
		isHidden
		formatString: 0
		sourceProviderType: bigint
		lineageTag: 802d1748-b710-4809-8387-a196a817e92f
		sourceLineageTag: ExperienceKey
		summarizeBy: none
		sourceColumn: ExperienceKey

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Business identifier assigned to a NorthStar experience. Use ExperienceName for display and grouping; do not aggregate this code.
	column ExperienceCode
		dataType: int64
		formatString: 0
		sourceProviderType: int
		lineageTag: 502d39da-b89a-4448-afce-3b17514a0956
		sourceLineageTag: ExperienceCode
		summarizeBy: none
		sourceColumn: ExperienceCode

		annotation SummarizationSetBy = Automatic

	/// Name of a NorthStar product or experience associated with a stay. No Experience means no experience was purchased.
	column ExperienceName
		dataType: string
		sourceProviderType: varchar(100)
		lineageTag: 56f75bf5-cd3f-48d4-a751-1e61d413cd5e
		sourceLineageTag: ExperienceName
		isDefaultLabel
		summarizeBy: none
		sourceColumn: ExperienceName

		annotation SummarizationSetBy = Automatic

	/// Category used to group NorthStar products and experiences, such as Wellness, Adventure, Culture, or Leisure.
	column ExperienceType
		dataType: string
		sourceProviderType: varchar(100)
		lineageTag: 4d66eabd-e150-4303-898b-739ab35b9228
		sourceLineageTag: ExperienceType
		summarizeBy: none
		sourceColumn: ExperienceType

		annotation SummarizationSetBy = Automatic

	column SourceUpdatedAt
		dataType: dateTime
		isHidden
		formatString: General Date
		sourceProviderType: datetime2
		lineageTag: 3420bbea-dcda-4b7d-81ef-fa39625ac5e1
		sourceLineageTag: SourceUpdatedAt
		summarizeBy: none
		sourceColumn: SourceUpdatedAt

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Experience drill path from experience type to individual experience.
	hierarchy Experience
		lineageTag: b325c9be-8742-4ec8-a9d5-a8942de31269

		level 'Experience Type'
			lineageTag: b86fa2f6-78ad-431c-b04d-dae89f3abcba
			column: ExperienceType

		level Experience
			lineageTag: 4dcdfcd5-ae73-4308-aa50-acb6409ee666
			column: ExperienceName

	partition DimExperience = entity
		mode: directLake
		source
			entityName: DimExperience
			schemaName: dw
			expressionSource: DatabaseQuery

	changedProperty = Description

