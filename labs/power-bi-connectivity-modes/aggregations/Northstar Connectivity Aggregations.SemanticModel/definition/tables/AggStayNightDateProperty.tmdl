	partition AggStayNightDateProperty = m
		mode: import
		source =
				let
				    Source = Sql.Database(WarehouseServer, WarehouseDatabase, [CreateNavigationProperties=false]),
				    Aggregation = Value.NativeQuery(Source, "SELECT StayDateKey, PropertyKey, COUNT_BIG(*) AS StayNights, SUM(CAST(RoomsOccupied AS bigint)) AS RoomsOccupied, CAST(SUM(RoomRevenue) AS float) AS RoomRevenue FROM dw.FactStayNight GROUP BY StayDateKey, PropertyKey", null, [EnableFolding=true])
