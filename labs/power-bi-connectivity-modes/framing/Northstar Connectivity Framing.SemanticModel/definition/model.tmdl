/// Isolated Direct Lake on OneLake framing demonstration over copied Northstar rows; no SQL fallback.
model sm_northstar_framing_demo
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation NorthstarDemoOwner = northstar-connectivity-framing-demo

ref table FactStayNight
ref table DimDate
ref table DimProperty

